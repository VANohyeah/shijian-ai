# 复制为 .env 后填真实值；.env 不得提交到仓库
# 只填一家即可；两家都填时默认优先智谱 GLM（可用 AI_PROVIDER 强制指定）

# --- 智谱 GLM（识图首选）---
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 文本模型候选，按顺序尝试，第一个能用的生效
# 实测：glm-4-flash 约 0.8s；glm-5.3-flash 约 3s 但更强；glm-4.6-flash 本账号 403
GLM_TEXT_MODELS=glm-4-flash,glm-5.3-flash
# 视觉模型候选，按顺序尝试
GLM_VISION_MODELS=glm-4v-flash,glm-4v-plus-0111,glm-5.3-flash

# --- DeepSeek（备用）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- 强制指定供应商：glm / deepseek（留空则自动）---
AI_PROVIDER=
